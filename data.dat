-5
# xmax
5
# ymin
-5
# ymax
5
# Total simulation time
7200
# Save time every
60
# npx
100
# npy
100
# CFL
0.9
# epsilon_h. Threshold for a cell to be considered dry.
1e-4
# Ratio of densities (>1)
2.6
# Mean diameter of sediment grain (>0)
2e-4
# Friction (Chezy) coefficient (>0)
2.5e-2
# Porosity (>=0 and <1.0):
0.4
# Critical theta:
0.0047
# Geometric mean size of suspended sediment, typically between 8e-6 to 128e-6
100e-6
# Output file name
sim
# Input file for bathymetry. If the proper flag is not set in code, this line will be ignored.
./example/westport_bathy_example.nc
# Input file for free surface initial condition and boundary conditions. Note that this file must be consistent with the bathy file. No checks are performed, so expect undefined behaviour otherwise. Read the README for instruction on the name convention for this file.
./example/new_westport_runupB_h.nc
# Input file with binary map for fixed bathymetry. If no map is required, enter 0. This file can have any size, but normally it would be consistent with the bathymetry file. Note that in the file, 1=sediment movement and 0=no sediment movement.
0
# Enter sea level correction for the simulation. In meters. Enter 0 for no correction.
0
#Input file for tides. Enter 0 for no input file. ALPHA!
0
